
from typing import Optional

from sqlalchemy import Integer, Text
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column

class Base(DeclarativeBase):
    pass

class ProcessServ(Base):
    __tablename__ = 'process_serv'

    pid: Mapped[int] = mapped_column(Integer, primary_key=True)
    process_name: Mapped[str] = mapped_column(Text(100))
    create_time: Mapped[int] = mapped_column(Integer)
    member_dept: Mapped[Optional[str]] = mapped_column(Text(100))
    last_time: Mapped[Optional[int]] = mapped_column(Integer)

    def to_dict(self):
        """将对象转换为字典"""
        return {
            'pid': self.pid,
            'process_name': self.process_name,
            'member_dept': self.member_dept,
            'create_time': self.create_time,
            'last_time': self.last_time
        }